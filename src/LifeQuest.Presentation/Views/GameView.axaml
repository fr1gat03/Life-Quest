<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LifeQuest.Presentation.ViewModels"
             x:Class="LifeQuest.Presentation.Views.GameView"
             x:DataType="vm:GameViewModel"
             x:CompileBindings="False"
             Background="#0D0A0E" FontFamily="Segoe UI">

    <Grid RowDefinitions="Auto, Auto, *">

        <!-- HEADER -->
        <Border Grid.Row="0" Padding="24,18" Background="#1A1218">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Аватар + ім'я -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            Spacing="14" VerticalAlignment="Center">
                    <Border Width="60" Height="60" CornerRadius="30"
                            BorderBrush="#C9A84C" BorderThickness="2"
                            BoxShadow="0 0 15 0 #44C9A84C">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#3D2A00" Offset="0"/>
                                <GradientStop Color="#5C3D00" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="{Binding AvatarDisplay, Mode=OneWay}"
                                   FontSize="24" FontWeight="Bold"
                                   Foreground="#C9A84C"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center" Spacing="5">
                        <TextBlock Text="{Binding PlayerName, Mode=OneWay}"
                                   FontSize="19" FontWeight="Bold"
                                   Foreground="#E8D5B7"/>
                        <Border Background="#2A1F0A" CornerRadius="8"
                                Padding="8,3" HorizontalAlignment="Left"
                                BorderBrush="#3D2E0A" BorderThickness="1">
                            <TextBlock Text="{Binding PlayerLevel, Mode=OneWay}"
                                       FontSize="11" Foreground="#C9A84C"
                                       FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- HP / XP бари -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center"
                            Spacing="10" Margin="30,0">

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="HP" Foreground="#E8D5B7"
                                   FontWeight="Bold" FontSize="12"
                                   Width="26" VerticalAlignment="Center"/>
                        <ProgressBar Value="{Binding CurrentHp, Mode=OneWay}"
                                     Maximum="{Binding MaxHp, Mode=OneWay}"
                                     Width="280" Height="12"
                                     Foreground="#8B2020" Background="#1A0A0A"
                                     CornerRadius="6"/>
                        <TextBlock Text="{Binding HpText, Mode=OneWay}"
                                   Foreground="#8B7355" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="XP" Foreground="#E8D5B7"
                                   FontWeight="Bold" FontSize="12"
                                   Width="26" VerticalAlignment="Center"/>
                        <ProgressBar Value="{Binding CurrentXp, Mode=OneWay}"
                                     Maximum="{Binding MaxXp, Mode=OneWay}"
                                     Width="280" Height="12"
                                     Foreground="#C9A84C" Background="#1A1400"
                                     CornerRadius="6"/>
                        <TextBlock Text="{Binding XpText, Mode=OneWay}"
                                   Foreground="#8B7355" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <!-- Золото -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="💰" FontSize="22" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Gold, Mode=OneWay}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="#C9A84C" VerticalAlignment="Center"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- Золотий роздільник -->
        <Border Grid.Row="1" Height="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#C9A84C" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- КОНТЕНТ -->
        <ScrollViewer Grid.Row="2" Margin="24,20">
            <StackPanel Spacing="0">

                <!-- Заголовок + кнопки -->
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,20">
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="⚔️" FontSize="20"/>
                        <TextBlock Text="Активні Звитки"
                                   FontSize="20" FontWeight="Bold"
                                   Foreground="#E8D5B7" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding OpenTavernCommand}"
                                CornerRadius="8" Padding="14,8"
                                Background="#2A1F2E"
                                BorderBrush="#4A2F5A" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="🧙‍♂️" VerticalAlignment="Center"/>
                                <TextBlock Text="Таверна" FontWeight="Bold"
                                           Foreground="#CBA6F7" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenCreateQuestCommand}"
                                CornerRadius="8" Padding="14,8"
                                BorderBrush="#3D2E0A" BorderThickness="1">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                    <GradientStop Color="#3D2A00" Offset="0"/>
                                    <GradientStop Color="#5C3D00" Offset="1"/>
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📜" VerticalAlignment="Center"/>
                                <TextBlock Text="Новий звит" FontWeight="Bold"
                                           Foreground="#C9A84C" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding OpenSettingsCommand}"
                                CornerRadius="8" Padding="14,8"
                                Background="#1A1218"
                                BorderBrush="#3D2E0A" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="📖" VerticalAlignment="Center"/>
                                <TextBlock Text="Книга Героя" FontWeight="Bold"
                                           Foreground="#8B7355" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Список квестів -->
                <ItemsControl ItemsSource="{Binding ActiveQuests}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10" CornerRadius="12"
                                    Background="#1A1218"
                                    BorderBrush="#3D2E0A" BorderThickness="1"
                                    BoxShadow="0 4 20 0 #00000060">
                                <Grid ColumnDefinitions="*, Auto" Margin="18,14">
                                    <StackPanel Grid.Column="0" Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="#E8D5B7" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock Text="{Binding DifficultyLabel}"
                                                       FontSize="12" FontWeight="Bold"
                                                       Foreground="{Binding DifficultyColor}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="·" Foreground="#3D2E0A"
                                                       FontSize="14" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="✨" FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding RewardXp, StringFormat='{}{0} XP'}"
                                                           Foreground="#C9A84C" FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <TextBlock Text="·" Foreground="#3D2E0A"
                                                       FontSize="14" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="💰" FontSize="11"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding RewardGold, StringFormat='{}{0} Gold'}"
                                                           Foreground="#8B7355" FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Замість яскравого Background="{Binding DifficultyColor}" -->
                                    <Button Grid.Column="1"
                                            Content="Виконати ✓"
                                            Command="{Binding CompleteCommand}"
                                            IsEnabled="{Binding IsNotCompleted}"
                                            VerticalAlignment="Center"
                                            Margin="16,0,0,0"
                                            FontSize="13" FontWeight="Bold"
                                            Foreground="{Binding DifficultyColor}"
                                            CornerRadius="8" Padding="16,8"
                                            Background="#1A1218"
                                            BorderBrush="{Binding DifficultyColor}"
                                            BorderThickness="1"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Мотиваційне повідомлення -->
                <Border CornerRadius="12" Padding="20,14"
                        Margin="0,10,0,0"
                        IsVisible="{Binding HasMotivation}"
                        Background="#1A1218"
                        BorderBrush="#3D2E0A" BorderThickness="1">
                    <StackPanel Spacing="6">
                        <TextBlock Text="────── ✦ ──────"
                                   Foreground="#3D2E0A" FontSize="12"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding MotivationMessage}"
                                   Foreground="#C9A84C" FontSize="13"
                                   FontStyle="Italic" TextWrapping="Wrap"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Версія -->
                <TextBlock Text="Life Quest v0.0.1 — Froggy TEAM"
                           Foreground="#3D2E0A" FontSize="10"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,10"/>

            </StackPanel>
        </ScrollViewer>

    </Grid>
</UserControl>