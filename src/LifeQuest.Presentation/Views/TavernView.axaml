<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:LifeQuest.Presentation.ViewModels"
             xmlns:models="using:LifeQuest.Application.Interfaces"
             x:Class="LifeQuest.Presentation.Views.TavernView"
             x:DataType="vm:TavernViewModel"
             x:CompileBindings="False"
             Background="#0D0A0E">

    <Grid RowDefinitions="Auto, Auto, *, Auto">

        <!-- ХЕДЕР -->
        <Border Grid.Row="0" Padding="20,14" Background="#1A1218">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Назад -->
                <Button Grid.Column="0" Command="{Binding BackCommand}"
                        Background="#0D0A0E"
                        BorderBrush="#3D2E0A" BorderThickness="1"
                        CornerRadius="8" Padding="12,7">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="⬅" Foreground="#8B7355"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="До карти" Foreground="#8B7355"
                                   FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Назва -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="🍺 Таверна 'Старий Кодер'"
                               FontSize="20" FontWeight="Bold"
                               Foreground="#C9A84C"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="────── ✦ ──────"
                               Foreground="#3D2E0A" FontSize="11"
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Кнопка додати квест -->
                <Button Grid.Column="2" Command="{Binding CreateQuestFromLastCommand}"
                        IsEnabled="{Binding HasNpcMessage}"
                        BorderBrush="#3D2E0A" BorderThickness="1"
                        CornerRadius="8" Padding="12,7">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#3D2A00" Offset="0"/>
                            <GradientStop Color="#5C3D00" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📜" VerticalAlignment="Center"/>
                        <TextBlock Text="Додати як звит"
                                   Foreground="#C9A84C" FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </Grid>
        </Border>

        <!-- Золотий роздільник -->
        <Border Grid.Row="1" Height="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="Transparent" Offset="0"/>
                    <GradientStop Color="#C9A84C" Offset="0.5"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- ЧАТ -->
        <ScrollViewer Name="ChatScrollViewer" Grid.Row="2" Margin="20,16,20,0"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding ChatHistory}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:ChatMessage">
                        <Border Margin="0,0,0,12" CornerRadius="12"
                                BorderThickness="1">

                            <!-- Різні стилі для NPC і гравця -->
                            <Border.Background>
                                <SolidColorBrush Color="#1A1218"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#3D2E0A"/>
                            </Border.BorderBrush>

                            <StackPanel Margin="16,12" Spacing="6">
                                <!-- Ім'я -->
                                <TextBlock Text="{Binding Role}"
                                           FontWeight="Bold"
                                           Foreground="#C9A84C"
                                           FontSize="14"/>
                                <SelectableTextBlock Text="{Binding Text}"
                                           Foreground="#E8D5B7"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           LineHeight="20"/>
                            </StackPanel>

                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ПОЛЕ ВВОДУ -->
        <Border Grid.Row="3" Padding="20,12,20,20"
                Background="#1A1218">
            <Border BorderBrush="#3D2E0A" BorderThickness="0,1,0,0">
                <Grid ColumnDefinitions="*, Auto" Margin="0,12,0,0">

                    <Border Grid.Column="0"
                            Background="#0D0A0E" CornerRadius="10"
                            BorderBrush="#3D2E0A" BorderThickness="1"
                            Margin="0,0,12,0">
                        <TextBox Text="{Binding UserInput}"
                                 PlaceholderText="Запитай щось у Елдора..."
                                 Background="Transparent"
                                 Foreground="#E8D5B7"
                                 BorderThickness="0"
                                 Padding="14,10"
                                 FontSize="14"/>
                    </Border>

                    <Button Grid.Column="1"
                            Command="{Binding SendCommand}"
                            IsEnabled="{Binding !IsLoading}"
                            CornerRadius="10" Padding="20,10"
                            BorderBrush="#6B2FC9" BorderThickness="1"
                            Background="#1A0A2E">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="✉️" FontSize="16"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Відправити"
                                       Foreground="#9B6FD4"
                                       FontSize="14" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>